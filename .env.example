# Copy to .env.local for local development, or set these in your hosting
# provider's environment variable settings for production. Every one of
# these is optional — the site runs and the lead flow genuinely works
# without any of them, using local fallbacks. See README.md section 3.

# --- Database (optional — falls back to local SQLite at data/chs.db) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (optional — falls back to logging to data/email-log.jsonl) ---
RESEND_API_KEY=
LEADS_FROM_EMAIL="CoreholdSolutions <notifications@coreholdsolutions.com>"
LEADS_NOTIFY_EMAIL=info@coreholdsolutions.com

# --- Payments (optional — pricing page falls back to a "talk to us" link) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Admin panel (/admin) — required to log in at all ---
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
